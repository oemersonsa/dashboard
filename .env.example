# ═══════════════════════════════════════════════════════════════
# EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para ".env" e preencha com valores reais:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── Servidor ───
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
# Na Vercel, PORT e HOST são desnecessários. Omita APP_ORIGIN para usar a URL
# automática do deploy ou defina a origem HTTPS do seu domínio personalizado.

# ─── Turso (banco de dados remoto) ───
# 1. Crie sua conta em https://turso.tech
# 2. Instale a CLI: curl -sSfL https://get.tur.so/install.sh | bash
# 3. Crie o banco: turso db create dashboard-vendas
# 4. Pegue a URL: turso db show dashboard-vendas --url
# 5. Gere um token: turso db tokens create dashboard-vendas
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=cole-seu-token-aqui

# ─── Mercado Livre (opcional) ───
# Cadastre uma aplicação no portal de desenvolvedores e habilite PKCE (S256).
# Configure a mesma redirect URI no portal. APP_ORIGIN deve ser a origem dela.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://seu-dominio.com/api/integrations/mercado-livre/callback
# Chave fixa de 32 bytes em base64. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde esta chave com segurança; trocar a chave exige reconectar as contas.
ML_TOKEN_ENCRYPTION_KEY=
