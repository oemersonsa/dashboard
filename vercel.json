{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "npm run build:vercel && npm run db:migrate",
  "outputDirectory": "dist",
  "crons": [{ "path": "/api/cron/mercado-livre", "schedule": "0 9 * * *" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/health/database", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/compiled/:file(app\\.[a-f0-9]{12}\\.css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
